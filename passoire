function detectLocale() {
  const sources = [
    process.env.LC_ALL,
    process.env.LC_MESSAGES,
    process.env.LANG,
    process.env.LANGUAGE,
  ];

  const seen = new Set();

  for (const source of sources) {
    if (!source) continue;

    for (const token of source.split(':')) {
      const normalized = token.trim().split(/[._@-]/)[0].toLowerCase();
      if (!normalized || seen.has(normalized)) continue;
      seen.add(normalized);

      if (messages[normalized]) {
        return normalized;
      }
    }
  }

  return 'en';
}

function formatMessage(locale, key, values = {}) {
  const template = (messages[locale] && messages[locale][key]) || messages.en[key];
  return template.replace(/%([A-Za-z0-9_]+)%/g, (_, name) => {
    const value = values[name];
    return value === undefined ? `%${name}%` : String(value);
  });
}

function checkPassword(password, locale) {
  return new Promise((resolve, reject) => {
    const hash = crypto.createHash('sha1').update(password).digest('hex').toUpperCase();
    const prefix = hash.substring(0, 5);
    const suffix = hash.substring(5);

    https.get(`https://api.pwnedpasswords.com/range/${prefix}`, (res) => {
      let data = '';

      res.on('data', (chunk) => {
        data += chunk;
      });

      res.on('end', () => {
        const lines = data.split('\n');
        const match = lines.find((line) => line.split(':')[0] === suffix);

        if (match) {
          const count = Number(match.split(':')[1].trim() || '0');
          resolve({ compromised: true, count });
          return;
        }

        resolve({ compromised: false, count: 0 });
      });
    }).on('error', reject);
  });
}

function run() {
  const locale = detectLocale();
  const args = process.argv.slice(2);

  if (args.includes('--help') || args.includes('-h')) {
    console.log('Usage: passoire [--phanerographic] [--help]');
    console.log('');
    console.log('Options:');
    console.log('  --phanerographic  Show the raw input value in batch output.');
    console.log('  --help            Show this help message.');
    return;
  }

  const showInput = args.includes('--phanerographic');
  const isInteractive = Boolean(process.stdin.isTTY && process.stdout.isTTY);
  let batchIndex = 0;
  let processingQueue = Promise.resolve();
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: isInteractive,
  });

  if (isInteractive) {
    rl.on('SIGINT', () => {
      rl.close();
    });

    rl.setPrompt(formatMessage(locale, 'prompt'));

    console.log(formatMessage(locale, 'title'));
    console.log(`${formatMessage(locale, 'intro')}\n`);
    rl.prompt();
  }

  rl.on('line', (line) => {
    processingQueue = processingQueue.then(async () => {
      const input = line.trim();

      if (!input) {
        if (isInteractive) {
          console.log(formatMessage(locale, 'empty'));
          rl.prompt();
        }
        return;
      }

      try {
        const result = await checkPassword(input, locale);

        if (isInteractive) {
          if (result.compromised) {
            console.log(formatMessage(locale, 'compromised', { count: result.count }));
          } else {
            console.log(formatMessage(locale, 'safe'));
          }
        } else {
          batchIndex += 1;
          const status = result.compromised
            ? formatMessage(locale, 'compromised', { count: result.count })
            : formatMessage(locale, 'safe');
          const value = showInput ? `: ${input}` : '';
          console.log(`${batchIndex}${value}: ${status}`);
        }
      } catch (err) {
        console.error(formatMessage(locale, 'error', { message: err.message }));
      }

      if (isInteractive) {
        rl.prompt();
      }
    });
  }).on('close', async () => {
    await processingQueue;
    if (isInteractive) {
      console.log(`\n${formatMessage(locale, 'disconnected')}`);
    }
  });
}

if (require.main === module) {
  run();
}

module.exports = {
  detectLocale,
  formatMessage,
  checkPassword,
};